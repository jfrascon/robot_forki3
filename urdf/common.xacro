<?xml version="1.0"?>
<!--
Common xacro file for the forki3 robot family.
THIS FILE IS NOT A COMPLETE ROBOT MODEL. IT IS MEANT TO BE INCLUDED FROM
THE PUBLIC MODEL XACRO FILES, FOR EXAMPLE MODEL_BASE.XACRO AND
MODEL_SENSETUP1.XACRO.

The common robot contains:
- the rectangular forklift base
- the three steerable wheels
- the simple fork
- the Gazebo plugins that belong to that common mechanical structure
-->
<robot name="forki3_common" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="robot_forki3_pkg_dir"              value="$(find robot_forki3)"/>
  <xacro:property name="robotics_description_pkg_dir"      value="$(find robotics_description)"/>

  <!-- ===================================================================== -->
  <!-- INCLUDES -->
  <!-- ===================================================================== -->

  <xacro:include filename="${robotics_description_pkg_dir}/urdf/common/all_commons.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/wheels/all_wheels.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/wheels/generic_macros/all_wheels_plugins.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/gz_system_plugins/all_gz_system_plugins.xacro"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <xacro:arg name="namespace"    default=""/>
  <xacro:arg name="robot_name"   default="forki3"/>
  <!--
  File containing the simulation configuration for the selected robot model.
  -->
  <xacro:arg name="sim_file"     default=""/>

  <!--
  User-configurable body options. The physical geometry, mass, mesh, scale, and wheel placement
  are fixed properties below so they remain consistent with the measured Forki3 model.
  -->
  <xacro:arg name="body_use_visual"    default="True"/>
  <xacro:arg name="body_use_collision" default="True"/>
  <xacro:arg name="body_use_inertial"  default="False"/>
  <xacro:arg name="body_color"         default=""/>

  <xacro:arg name="fork_use_visual"    default="True"/>
  <xacro:arg name="fork_use_collision" default="True"/>
  <xacro:arg name="fork_color"         default=""/>

  <!-- Wheel collision is always enabled. Each wheel visual can be disabled independently. -->
  <xacro:arg name="s_wheel_front_use_visual" default="True"/>
  <xacro:arg name="s_wheel_left_use_visual"  default="True"/>
  <xacro:arg name="s_wheel_right_use_visual" default="True"/>
  <xacro:arg name="s_wheel_use_inertial"     default="True"/>
  <xacro:arg name="s_wheel_color"            default="0.0 0.0 0.0 1.0"/>
  <!--
  Note: If you want the wheel to be able to reach +-pi rad angle (+-180 degress), set limits to +-3.1416.
  pi = 3.141592654.... < 3.1416
  -->

  <!-- Create properties from args for easy manipulation. -->

  <xacro:property name="namespace"    value="$(arg namespace)"/>
  <xacro:property name="robot_name"   value="$(arg robot_name)"/>

  <!-- Set the property 'robot_namespace' -->
  <xacro:make_namespace prop_id="robot_namespace" namespace="${namespace}" name="${robot_name}"/>

  <!-- Set the property 'robot_prefix' -->
  <xacro:make_prefix prop_id="robot_prefix" name="${robot_name}"/>

  <!-- A non-empty sim_file enables the simulation plugins configured by that file. -->
  <xacro:property name="sim_file_raw" value="$(arg sim_file)"/>
  <xacro:property name="sim_file"     value="${str(sim_file_raw).strip()}"/>
  <xacro:property name="sim_cfg"
                  value="${xacro.load_yaml(sim_file) if sim_file != '' else dict()}"/>

  <!-- Names for components -->
  <xacro:property name="base_name"                value="base"/>
  <xacro:property name="steerable_wheel_0_name"   value="steerable_wheel_0"/>
  <xacro:property name="steerable_wheel_1_name"   value="steerable_wheel_1"/>
  <xacro:property name="steerable_wheel_2_name"   value="steerable_wheel_2"/>
  <xacro:property name="fork_name"                value="fork"/>

  <xacro:property name="robot_size_x" value="2.733"/>
  <xacro:property name="robot_size_y" value="0.75"/>
  <xacro:property name="robot_size_z" value="1.8464685678"/>

  <xacro:property name="body_use_visual"    value="$(arg body_use_visual)"/>
  <xacro:property name="body_use_collision" value="$(arg body_use_collision)"/>
  <xacro:property name="body_use_inertial"  value="$(arg body_use_inertial)"/>

  <!--
  Base model overview:
  - The base is composed of the chassis body and three steerable wheels (one longitudinal on the
    x-axis, plus left and right).
  - The chassis mesh is used for visual and collision representation.
  - Dynamics are intentionally simplified: the chassis link uses null inertia, and the effective
    base mass/inertia are concentrated in an internal ballast link.

  Ballast model:
  - The ballast is a simple box located at the bottom of the chassis to keep the center of mass low
    and improve numerical stability.
  - This ballast represents the bulk mass of the real platform (including internal components not
    modeled in detail).
  - The ballast has no visual or collision geometry because it is fully inside the chassis; only its
    inertial properties are used.
  - This is a deliberate reduced-order dynamic model aimed at stable and practical simulation, not a
    full mass-distribution reconstruction of the real vehicle.
  -->
  <xacro:property name="mass"             value="500"/>
  <xacro:property name="body_size"        value="1.5030344725 0.750000 1.6400002837"/>
  <xacro:property name="body_size_values" value="${body_size.split()}"/>

  <!--
  The property 'body_size_values' is a list of the three components of 'body_size', which are
  expected to be separated by spaces.
  -->
  <xacro:if value="${len(body_size_values) != 3}">
    ${xacro.fatal("body_size must contain exactly 3 values: x y z")}
  </xacro:if>

  <xacro:property name="body_size_x"           value="${float(body_size_values[0])}"/>
  <xacro:property name="body_size_y"           value="${float(body_size_values[1])}"/>
  <xacro:property name="body_size_z"           value="${float(body_size_values[2])}"/>
  <xacro:property name="body_ground_clearance" value="0.060468"/>
  <xacro:property name="dist_to_wheels"        value="0.4861583853484584"/>


  <xacro:if value="${float(dist_to_wheels) &lt;= 0.0}">
    ${xacro.fatal("dist_to_wheels must be > 0")}
  </xacro:if>

  <!--
  The frame of the body mesh is located at the geometric center in between the wheels, at the bottom
  of the mesh, which is exactly the point where to position the ${base_name}_link.
  Scale is configured with `body_scale`.
  The visual mesh provides its own material. Set `body_color` to override it.
  To access the mesh just use <package>/<path_to_mesh_within_package>.
  -->
  <xacro:property name="body_visual_mesh"    value="robot_forki3/meshes/forklift_body.obj"/>
  <xacro:property name="body_collision_mesh" value="robot_forki3/meshes/forklift_body.stl"/>
  <xacro:property name="body_scale"          value="1.0 1.0 1.0"/>
  <xacro:property name="body_color"          value="$(arg body_color)"/>

  <!-- ===================================================================== -->
  <!-- Definition of links and joints for the rectangular base -->
  <!-- ===================================================================== -->

  <!--
  The link '${base_name}footprint_link' is located on the ground, just below the link
  '${base_name}_link', at a distance of 'ground_clearance' meters.
  -->
  <link name="${robot_prefix}${base_name}_footprint_link"/>

  <link name="${robot_prefix}${base_name}_link">
  <!--
  Visual and collision geometry can be disabled independently for the base body.
  The ballast is inside the body, so it has no visual or collision elements.
  -->
    <xacro:property name="body_visual_color"
                    value="${robot_prefix + base_name + '_color ' + body_color if body_color != '' else ''}"/>
    <xacro:if value="${body_use_visual}">
      <xacro:visual_mesh
        mesh="${body_visual_mesh}"
        scale="${body_scale}"
        mesh_origin="0 0 0 0 0 0"
        color="${body_visual_color}"/>
    </xacro:if>

    <xacro:if value="${body_use_collision}">
      <xacro:collision_mesh
        mesh="${body_collision_mesh}"
        scale="${body_scale}"
        mesh_origin="0 0 0 0 0 0"/>
    </xacro:if>

    <xacro:null_inertia/>
  </link>

  <joint name="${robot_prefix}${base_name}_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_footprint_link"/>
    <child link="${robot_prefix}${base_name}_link"/>
    <!--
    The link '${base_name}_link' is located at the center of the bottom face of the body, so it is
    at a height of 'ground_clearance' meters above the link '${base_name}_footprint_link'.
    -->
    <origin rpy="0 0 0" xyz="0 0 ${body_ground_clearance}"/>
  </joint>

  <!--
  The ballast is modeled as a box.
  the bottom face. This makes the ballast-link frame coincide with the body-link frame.
  No visual or collision geometry is defined for the ballast because it is fully contained inside
  the body.
  The ballast inertia is enabled only when `body_use_inertial` is enabled.
  -->
  <link name="${robot_prefix}${base_name}_ballast_link">
    <xacro:if value="${body_use_inertial}">
      <xacro:solid_box_inertia mass="${mass}"
                               size="0.8997000158 0.6679999828 0.015"
                               origin="0 0 0 0 0 0"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
        <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}${base_name}_ballast_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}${base_name}_ballast_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.23130818456411362 0.0 0.30250023305416107"/>
  </joint>

  <!--
  Definition of the steerable wheels.

  Wheel numbering aligned with ground_vehicle_kinematics:
  steerable_wheel_0 -> wheel on the robot X axis (x > 0 or x < 0 depending on geometry)
  steerable_wheel_1 -> left wheel
  steerable_wheel_2 -> right wheel
  Reference: package://ground_vehicle_kinematics/doc/kinematics_en.pdf

  Wheel always use collision elements, which means 's_wheel_use_collision' is always True.
  Wheel always use a basic geometry for collision, which means 's_wheel_use_c_mesh' is always False.
  Read the steerable_wheel macro for more details.
  -->
  <xacro:property name="s_wheel_use_inertial" value="$(arg s_wheel_use_inertial)"/>

  <xacro:property name="s_wheel_mass"                 value="10.0"/>
  <xacro:property name="s_wheel_radius"               value="0.127"/>
  <xacro:property name="s_wheel_thickness"            value="0.082"/>
  <xacro:property name="s_wheel_mesh"                 value=""/>
  <xacro:property name="s_wheel_mesh_scale"           value="1.0 1.0 1.0"/>
  <xacro:property name="s_wheel_color"                value="$(arg s_wheel_color)"/>
  <xacro:property name="s_wheel_steering_joint_type"  value="revolute"/>
  <!--
  With this limits the steering joint can rotate from [-pi, pi] radians.
  -->
  <!--
  Important:
  The motion of this robot is controlled in velocity mode by a plugin of type
  'gz::sim::systems::VelocityControl'.
  Each wheel is not commanded directly through torque/force or velocity commands.
  Therefore, accurate values for the friction parameters of the wheel are not required
  (mu, mu2, slip1, slip2), just values that provide low friction to minimize the interaction of the
  wheels with the ground and allow the robot to move smoothly
  Besides, the velocity limit and effort limit for the steering and rotation joints are set to such
  a high values that they model ideal joints.
  This is useful when the robot is controlled in velocity mode, to avoid the joint limits from
  interfering with the control.
  Read the macro 'steerable_wheel_macro.xacro' for more details about these limit parameters.
  -->
  <xacro:property name="s_wheel_steering_joint_limits" value="-3.1416 3.1416 100.0 100000.0"/>
  <xacro:property name="s_wheel_rotation_joint_type"   value="continuous"/>
  <xacro:property name="s_wheel_rotation_joint_limits" value="100.0 100000.0"/>

  <!-- z-coordinate of each steerable wheel w.r.t it parent frame -->
  <xacro:property name="z_s_wheel" value="${-body_ground_clearance + s_wheel_radius}"/>
  <!--
  The two rear wheels are symmetric about the x-axis.
  Their calibrated coordinates follow the same polar-form relationship used by the previous geometry
  calculation:
  - `d` is `dist_to_wheels`, the radial distance from the base-frame origin to either rear wheel:
      d = dist_to_wheels = sqrt(x_left^2 + y_left^2)
  - `alpha` is the positive angle from the x-axis to the left wheel:
      alpha = atan2(y_left, x_left)
  - Left wheel uses angle +alpha:
      x_left = d*cos(+alpha)
      y_left = d*sin(+alpha)
  - Right wheel uses angle -alpha:
      x_right = d*cos(-alpha)
      y_right = d*sin(-alpha)
  Using trigonometric parity:
  - cos(-alpha) = cos(alpha), so x_right = x_left.
  - sin(-alpha) = -sin(alpha), so y_right = -y_left.
  The values below are the measured coordinates in the stl file for the body.
  longitudinal wheel remains on the x-axis and uses `dist_to_wheels` as its x coordinate.
  -->
  <xacro:property name="x_s_wheel_left"  value="-0.43454164266586304"/>
  <xacro:property name="y_s_wheel_left"  value="0.2179989367723465"/>
  <xacro:property name="x_s_wheel_right" value="-0.43454164266586304"/>
  <xacro:property name="y_s_wheel_right" value="-0.2179989367723465"/>
  <xacro:property name="x_s_wheel_front" value="${dist_to_wheels}"/>

  <!--
  The steerable_wheel macro creates:
  - Links:
    * ${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_link
  - Joints:
    * ${prefix}${name}_steering_joint (revolute|fixed):
      parent=${parent_frame}, child=${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_joint (continuous|fixed):
      parent=${prefix}${name}_steerable_link, child=${prefix}${name}_rotation_link
  -->
  <xacro:steerable_wheel name="${steerable_wheel_0_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="$(arg s_wheel_front_use_visual)"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_front} 0.0 ${z_s_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${steerable_wheel_1_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="$(arg s_wheel_left_use_visual)"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_left} ${y_s_wheel_left} ${z_s_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${steerable_wheel_2_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="$(arg s_wheel_right_use_visual)"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_right} ${y_s_wheel_right} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- ===================================================================== -->
  <!-- FORK -->
  <!-- ===================================================================== -->
  <xacro:property name="fork_limits"         value="-0.005 0.8 0.2 20000.0"/>
  <xacro:property name="fork_dynamics"       value="10.0 1.0"/>
  <xacro:property name="fork_rest_clearance" value="0.03"/>

  <!-- Pose checked with Blender -->
  <xacro:property name="fork_joint_parent_fr_root_fr" value="-0.762842 0 0.159212 0 0 ${pi}"/>

  <xacro:property name="fork_controller_sim_cfg" value="${sim_cfg.get('fork_controller', dict())}"/>
  <xacro:property name="fork_controller_enabled" value="${fork_controller_sim_cfg.get('enabled', False)}"/>
  <xacro:property name="fork_controller_initial_position"
                  value="${fork_controller_sim_cfg.get('initial_position', '')}"/>
  <xacro:property name="fork_controller_topic"   value="${fork_controller_sim_cfg.get('topic', '')}"/>
  <xacro:property name="fork_controller_vel_max" value="${fork_controller_sim_cfg.get('vel_max', 0.04)}"/>

  <xacro:include filename="${robot_forki3_pkg_dir}/urdf/fork_macro.xacro"/>

  <xacro:fork name="${fork_name}"
              prefix="${robot_prefix}"
              parent_frame="${robot_prefix}${base_name}_link"
              joint_parent_fr_root_fr="${fork_joint_parent_fr_root_fr}"
              use_visual="$(arg fork_use_visual)"
              use_collision="$(arg fork_use_collision)"
              color="$(arg fork_color)"
              limits="${fork_limits}"
              dynamics="${fork_dynamics}"
              rest_clearance="${fork_rest_clearance}"
              controller_enabled="${fork_controller_enabled}"
              controller_initial_position="${fork_controller_initial_position}"
              controller_topic="${fork_controller_topic}"
              controller_vel_max="${fork_controller_vel_max}"
              robot_namespace="${robot_namespace}"/>

  <!-- ===================================================================== -->
  <!-- PLUGINS FOR THE BASE -->
  <!-- ===================================================================== -->

  <xacro:if value="${sim_file != ''}">
    <gazebo>
      <xacro:property name="battery_sim_cfg" value="${sim_cfg.get('battery', dict())}"/>

      <xacro:if value="${battery_sim_cfg.get('enabled', False)}">
        <xacro:property name="battery_voltage" value="${battery_sim_cfg.get('voltage', '')}"/>
        <xacro:property name="battery_capacity" value="${battery_sim_cfg.get('capacity', '')}"/>
        <xacro:property name="battery_power_load" value="${battery_sim_cfg.get('power_load', '')}"/>

        <xacro:if value="${battery_voltage == ''}">
          ${xacro.fatal("battery.voltage is required when battery.enabled is true")}
        </xacro:if>

        <xacro:if value="${battery_capacity == ''}">
          ${xacro.fatal("battery.capacity is required when battery.enabled is true")}
        </xacro:if>

        <xacro:if value="${battery_power_load == ''}">
          ${xacro.fatal("battery.power_load is required when battery.enabled is true")}
        </xacro:if>

        <xacro:property name="battery_power_draining_topic"
                        value="${battery_sim_cfg.get('power_draining_topic', '')}"/>
        <xacro:if value="${battery_power_draining_topic != ''}">
          <xacro:resolve_topic prop_id="battery_power_draining_topic"
                               topic="${battery_power_draining_topic}"
                               namespace="${robot_namespace}"/>
        </xacro:if>

        <xacro:property name="battery_stop_power_draining_topic"
                        value="${battery_sim_cfg.get('stop_power_draining_topic', '')}"/>
        <xacro:if value="${battery_stop_power_draining_topic != ''}">
          <xacro:resolve_topic prop_id="battery_stop_power_draining_topic"
                               topic="${battery_stop_power_draining_topic}"
                               namespace="${robot_namespace}"/>
        </xacro:if>

        <xacro:plugin_linear_battery
          name="main_battery"
          voltage="${battery_voltage}"
          capacity="${battery_capacity}"
          power_load="${battery_power_load}"
          fix_issue_225="${battery_sim_cfg.get('fix_issue_225', True)}"
          open_circuit_voltage_constant_coef="${battery_sim_cfg.get('open_circuit_voltage_constant_coef', '')}"
          open_circuit_voltage_linear_coef="${battery_sim_cfg.get('open_circuit_voltage_linear_coef', '')}"
          initial_charge="${battery_sim_cfg.get('initial_charge', '')}"
          resistance="${battery_sim_cfg.get('resistance', '')}"
          smooth_current_tau="${battery_sim_cfg.get('smooth_current_tau', '')}"
          invert_current_sign="${battery_sim_cfg.get('invert_current_sign', '')}"
          start_draining="${battery_sim_cfg.get('start_draining', '')}"
          power_draining_topic="${battery_power_draining_topic}"
          stop_power_draining_topic="${battery_stop_power_draining_topic}"
          enable_recharge="${battery_sim_cfg.get('enable_recharge', '')}"
          charging_time="${battery_sim_cfg.get('charging_time', '')}"
          recharge_by_topic="${battery_sim_cfg.get('recharge_by_topic', '')}"/>
      </xacro:if>

      <!--
      To find the reference for the system Gazebo plugins:
      1. Go to: https://gazebosim.org/libs/
      2. Click in the link 'API & Tutorials' for the 'Sim' section.
      3. Click in the link 'gz::sim::systems'

      At the time of writing this text (March 2026), the link 'gz::sim::systems' points to the
      URL 'https://gazebosim.org/api/sim/10/namespacegz_1_1sim_1_1systems.html', for API reference
      10.1.1
      -->

      <!--
      Insert a the `VelocityControl` Gazebo plugin to control the robot's motion by applying the twist received on a
      message in a subscribed topic.
      The twist is applied directly to the robot's model in Gazebo, without simulating the effect of forces on the
      wheels or the ground.
      This allows for a simple and stable way to control the robot's motion in velocity mode, without the need to tune
      friction parameters or worry about wheel slip.
      -->
      <xacro:property name="base_velocity_controller_sim_cfg"
                      value="${sim_cfg.get('base_velocity_controller', dict())}"/>

      <xacro:if value="${base_velocity_controller_sim_cfg.get('enabled', False)}">
        <!--
        Preppend the prefix `bvc_` to all the properties related to the (b)ase (v)elocity
        (c)ontroller Gazebo plugin, to avoid name conflicts with other Gazebo plugins.
        -->
        <xacro:property name="bvc_topic" value="${base_velocity_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${bvc_topic == ''}">
          ${xacro.fatal(
            "base_velocity_controller.topic is required when base_velocity_controller.enabled is true.")}
        </xacro:if>

        <xacro:if value="${bvc_topic != ''}">
          <xacro:resolve_topic prop_id="bvc_resolved_topic"
                               topic="${bvc_topic}"
                               namespace="${robot_namespace}"/>

          <xacro:property name="bvc_initial_linear_vel"
                          value="${base_velocity_controller_sim_cfg.get('initial_linear_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:property name="bvc_initial_angular_vel"
                          value="${base_velocity_controller_sim_cfg.get('initial_angular_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:plugin_velocity_control
            topic="${bvc_resolved_topic}"
            initial_linear="${bvc_initial_linear_vel['x']} ${bvc_initial_linear_vel['y']} ${bvc_initial_linear_vel['z']}"
            initial_angular="${bvc_initial_angular_vel['x']} ${bvc_initial_angular_vel['y']} ${bvc_initial_angular_vel['z']}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Publish the pose of the robot base with respect to a configured reference frame.
      More details are available in
      package://robotics_description/urdf/gz_system_plugins/plugin_pose_publisher_in_reference_frame_macro.xacro.
      -->
      <xacro:property name="pose_publisher_sim_cfg"
                      value="${sim_cfg.get('pose_publisher', dict())}"/>

      <xacro:if value="${pose_publisher_sim_cfg.get('enabled', False)}">
        <xacro:property name="pose_pub_topic"
                        value="${pose_publisher_sim_cfg.get('topic', '') or ''}"/>
        <xacro:property name="pose_pub_topic_with_covariance"
                        value="${pose_publisher_sim_cfg.get('topic_with_covariance', '') or ''}"/>
        <xacro:property name="pose_pub_tf_topic"
                        value="${pose_publisher_sim_cfg.get('tf_topic', '') or ''}"/>

        <xacro:if value="${pose_pub_topic == '' and pose_pub_topic_with_covariance == '' and pose_pub_tf_topic == ''}">
          ${xacro.fatal("pose_publisher requires at least one output topic when enabled.")}
        </xacro:if>

        <xacro:if value="${pose_pub_topic != '' or pose_pub_topic_with_covariance != '' or pose_pub_tf_topic != ''}">
          <xacro:if value="${pose_pub_topic != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_topic"
                                 topic="${pose_pub_topic}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_topic == ''}">
            <xacro:property name="pose_pub_resolved_topic" value=""/>
          </xacro:if>

          <xacro:if value="${pose_pub_topic_with_covariance != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_topic_with_covariance"
                                 topic="${pose_pub_topic_with_covariance}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_topic_with_covariance == ''}">
            <xacro:property name="pose_pub_resolved_topic_with_covariance" value=""/>
          </xacro:if>

          <xacro:if value="${pose_pub_tf_topic != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_tf_topic"
                                 topic="${pose_pub_tf_topic}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_tf_topic == ''}">
            <xacro:property name="pose_pub_resolved_tf_topic" value=""/>
          </xacro:if>

          <xacro:property name="pose_pub_reference_frame"
                          value="${pose_publisher_sim_cfg.get('reference_frame', '') or ''}"/>
          <xacro:if value="${pose_pub_reference_frame == ''}">
            ${xacro.fatal("pose_publisher.reference_frame is required when enabled.")}
          </xacro:if>

          <xacro:property name="pose_pub_local_offset"
                          value="${pose_publisher_sim_cfg.get(
                            'local_offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>
          <xacro:property name="pose_pub_global_offset"
                          value="${pose_publisher_sim_cfg.get(
                            'global_offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>
          <xacro:property name="pose_pub_gaussian_noise"
                          value="${pose_publisher_sim_cfg.get('gaussian_noise', 0)}"/>
          <xacro:property name="pose_pub_msg_publication_freq"
                          value="${pose_publisher_sim_cfg.get('msg_publication_freq', 50)}"/>

          <xacro:plugin_pose_publisher_in_reference_frame
            reference_frame="${pose_pub_reference_frame}"
            robot_frame="${robot_prefix}${base_name}_footprint_link"
            msg_publication_freq="${pose_pub_msg_publication_freq}"
            topic="${pose_pub_resolved_topic}"
            topic_with_covariance="${pose_pub_resolved_topic_with_covariance}"
            tf_topic="${pose_pub_resolved_tf_topic}"
            dimensions="2"
            xyz_offset="${pose_pub_local_offset['x']} ${pose_pub_local_offset['y']} ${pose_pub_local_offset['z']}"
            rpy_offset="${pose_pub_local_offset['R']} ${pose_pub_local_offset['P']} ${pose_pub_local_offset['Y']}"
            xyz_global_offset="${pose_pub_global_offset['x']} ${pose_pub_global_offset['y']} ${pose_pub_global_offset['z']}"
            rpy_global_offset="${pose_pub_global_offset['R']} ${pose_pub_global_offset['P']} ${pose_pub_global_offset['Y']}"
            gaussian_noise="${pose_pub_gaussian_noise}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 3 'JointPositionController' Gazebo plugins, each one to control the steering joint of
      each steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      position of the steering joints.
      Velocity commands, derived from the positions, are used to control the steering joints,
      instead of using PIDs.
      By using velocity commands, bypassing the PIDs, we can achieve a perfect position for the
      steering joints.

      'sj' -> steering joint.
      -->

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 0.
       -->

      <xacro:property name="sw0_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_0_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw0_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw0_sj_topic"
                        value="${sw0_sj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw0_sj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_0_steering_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw0_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_0_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw0_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw0_sj_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 1.
       -->

      <xacro:property name="sw1_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_1_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw1_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw1_sj_topic"
                        value="${sw1_sj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw1_sj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_1_steering_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw1_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_1_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw1_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw1_sj_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 2.
       -->

      <xacro:property name="sw2_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_2_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw2_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw2_sj_topic"
                        value="${sw2_sj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw2_sj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_2_steering_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw2_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_2_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw2_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw2_sj_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 3 'JointController' Gazebo plugins, each one to control the rotation joint of each
      steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      velocity of the rotation joints.
      Pure velocity commands (no force derived from velocity) are used to control the steering joints,
      instead of using PIDs.

      'rj' -> rotation joint.
      -->

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 0.
       -->
      <xacro:property name="sw0_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_0_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw0_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw0_rj_topic"
                        value="${sw0_rj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw0_rj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_0_rotation_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw0_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_0_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw0_rj_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 1.
       -->
      <xacro:property name="sw1_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_1_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw1_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw1_rj_topic"
                        value="${sw1_rj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw1_rj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_1_rotation_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw1_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_1_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw1_rj_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 2.
       -->
      <xacro:property name="sw2_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_2_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw2_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw2_rj_topic"
                        value="${sw2_rj_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${sw2_rj_topic == ''}">
          ${xacro.fatal(
            "base_steerable_wheel_2_rotation_joint_controller.topic is required when enabled.")}
        </xacro:if>

        <xacro:if value="${sw2_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_2_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw2_rj_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

    </gazebo>
  </xacro:if>
</robot>
